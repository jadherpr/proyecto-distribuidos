GROUP_NAME=g2

# URL con la que el servidor central debe alcanzar este servidor.
# En la sesion de interoperabilidad: la IP o host visible en la red de la sala.
PUBLIC_URL=http://server:8000

# URL del servidor central del profesor.
# Para pruebas locales con el central simulado: http://localhost:9000
CENTRAL_URL=http://localhost:9000

# Puerto local donde escucha el servidor del grupo.
PORT=8000

# Nombre del segundo servidor para pruebas locales (perfil "local").
GROUP_NAME_B=g2b

# Intervalos en segundos.
REGISTER_INTERVAL=30
HEARTBEAT_INTERVAL=5
HEARTBEAT_MAX_FAILS=3
